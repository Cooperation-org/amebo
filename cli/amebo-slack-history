#!/usr/bin/env python3
"""amebo-slack-history — recent messages in the Slack channel amebo-max is answering in.

Usage: amebo-slack-history [count]     (default 30, max 200)

The channel comes only from $AMEBO_MAX_CHANNEL, which amebo-max sets for the
one Claude turn it runs, so the caller cannot point it at another channel.
The bot token is read here from backend/.env and never printed.
"""
import json
import os
import sys
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

ENV_FILE = Path(__file__).resolve().parent.parent / "backend" / ".env"


def token():
    for line in ENV_FILE.read_text().splitlines():
        if line.startswith("SLACK_BOT_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit("SLACK_BOT_TOKEN not found")


def call(method, **params):
    req = urllib.request.Request(
        f"https://slack.com/api/{method}?{urllib.parse.urlencode(params)}",
        headers={"Authorization": f"Bearer {token()}"})
    data = json.load(urllib.request.urlopen(req, timeout=20))
    if not data.get("ok"):
        sys.exit(f"slack {method}: {data.get('error')}")
    return data


def main():
    channel = os.environ.get("AMEBO_MAX_CHANNEL")
    if not channel:
        sys.exit("no channel: only works inside an amebo-max answer")
    count = min(int(sys.argv[1]) if len(sys.argv) > 1 else 30, 200)
    msgs = list(reversed(call("conversations.history", channel=channel, limit=count)["messages"]))
    names = {}
    for m in msgs:
        uid = m.get("user")
        if uid and uid not in names:
            u = call("users.info", user=uid)["user"]
            names[uid] = u.get("profile", {}).get("display_name") or u.get("real_name") or uid
        who = names.get(uid, "amebo" if m.get("bot_id") else "someone")
        when = datetime.fromtimestamp(float(m["ts"]), timezone.utc).strftime("%Y-%m-%d %H:%M")
        replies = f" [{m['reply_count']} replies]" if m.get("reply_count") else ""
        print(f"{when} {who}: {m.get('text', '')}{replies}")


if __name__ == "__main__":
    main()
