#!/usr/bin/env python3
"""amebo-taiga — mcp-taiga as the amebo Taiga user, for amebo-max.

Usage: amebo-taiga [--site workersvc] <verb> [args...]
       verbs: see VERBS; same args as mcp-taiga.

--site picks the Taiga: default taiga.linkedtrust.us (TAIGA_URL, TAIGA_USERNAME,
TAIGA_PASSWORD); --site <name> reads TAIGA_<NAME>_URL, _USERNAME, _PASSWORD.

The Taiga login (TAIGA_URL, TAIGA_USERNAME, TAIGA_PASSWORD) is read here from
backend/.env and handed only to mcp-taiga, so it never reaches the caller's
environment. HOME is a fresh empty directory, so the caller's own
~/.mcp-taiga.conf (a person's login) is never used.
"""
import os
import shutil
import subprocess
import sys
import tempfile

from _amebo_env import read_env

# No attach (reads local files), add-member, onboard, login.
VERBS = {"projects", "members", "statuses", "users", "list", "show",
         "create", "update", "move", "comment", "task"}


def main():
    argv = sys.argv[1:]
    prefix = "TAIGA_"
    if argv[:1] == ["--site"] and len(argv) > 1:
        prefix = f"TAIGA_{argv[1].upper()}_"
        argv = argv[2:]
    if not argv or argv[0] not in VERBS:
        sys.exit(f"usage: amebo-taiga [--site <name>] <{'|'.join(sorted(VERBS))}> [args...]")
    site = read_env(*(prefix + k for k in ("URL", "USERNAME", "PASSWORD")))
    creds = {"TAIGA_" + k[len(prefix):]: v for k, v in site.items()}
    # A shell argument cannot easily hold a newline, so the description takes
    # a literal \n for one; \n\n separates paragraphs (Taiga renders Markdown).
    args = list(argv)
    for i, a in enumerate(args[:-1]):
        if a in ("-d", "--description"):
            args[i + 1] = args[i + 1].replace("\\n", "\n")
    tool = shutil.which("mcp-taiga")
    if not tool:
        sys.exit("mcp-taiga not on PATH")
    with tempfile.TemporaryDirectory() as home:
        env = {**os.environ, **creds, "HOME": home}
        sys.exit(subprocess.run([tool, *args], env=env).returncode)


if __name__ == "__main__":
    main()
