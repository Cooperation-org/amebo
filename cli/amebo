#!/usr/bin/env bash
# amebo — talk to amebo in your terminal, like claude on the command line.
#
# Same conversation core as the Slack path (ConversationManager): stable cached
# system prefix, rolling cache breakpoints, turns persisted verbatim so the
# prompt-cache prefix hits, compaction past the token threshold. Plus a `shell`
# tool for this verified-personal session.
#
# Model/provider are decoupled from the mode — override any of these:
#   AMEBO_CLI_PROVIDER   llm provider for THIS process (default: minimax)
#   AMEBO_CLI_MODEL      model id; under provider=minimax the served model is
#                        MINIMAX_MODEL from .env (currently MiniMax-M3) and this
#                        is ignored — it takes effect under provider=anthropic.
#   AMEBO_CLI_SESSION    thread name; reuse to resume a conversation
#   AMEBO_CLI_INSTANCE   amebo instance slug (default: whatscookin)
# The running Slack service is untouched — these apply only to this shell.
# Opus needs Anthropic API credits (a Max subscription cannot fund the API):
#   AMEBO_CLI_PROVIDER=anthropic AMEBO_CLI_MODEL=claude-opus-4-8 amebo
#
# Usage:  amebo        new session
#         amebo -c     resume your last session
#         amebo -r     list past sessions, pick one to resume
#         amebo -y     auto mode: run commands without asking (destructive ones still ask)
#         amebo --skip-permissions   everything runs without asking, except sudo
#         amebo --mode=code          opt-in code mode: file editing, runs in this directory
#         amebo --permissions=ask|edit|auto|skip   what runs without asking (default: ask)
#         amebo --model=kimi|minimax|anthropic|<model id>   e.g. --model=claude-opus-5-5
#   In a session: /mode, /permissions, /model switch these. /model lists which keys are set.
set -euo pipefail

BACKEND="/opt/shared/repos/amebo/backend"
export AMEBO_CLI_CWD="$PWD"   # code mode works where you started amebo
cd "$BACKEND"

# .env (DB creds, API keys) is loaded by the app via python-dotenv from this
# cwd — not sourced in bash, which chokes on values with spaces (e.g. Gmail app
# passwords). Caller env still wins: python-dotenv does not override existing vars.
export AMEBO_PERSONAL_MODE=1
export AMEBO_PERSONAL_UID="$(id -u)"
export AMEBO_CLI_PROVIDER="${AMEBO_CLI_PROVIDER:-minimax}"
# The embedding model (knowledge-base search) prints a Hub warning, a progress
# bar and a load report to the terminal on first use. Keep the transcript clean.
export HF_HUB_DISABLE_PROGRESS_BARS=1 HF_HUB_VERBOSITY=error TRANSFORMERS_VERBOSITY=error

exec ./venv/bin/python -m src.personal.repl "$@"
