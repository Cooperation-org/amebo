#!/usr/bin/env python3
"""amebo-elm — call elm's /api (CRM opportunities, campaigns, activities) with
ELM_API_KEY from backend/.env, for amebo-max.

Usage: amebo-elm GET  <path>            e.g. amebo-elm GET /api/search?q=candid
       amebo-elm POST|PATCH <path> '<json body>'

Only /api/ paths; no DELETE.
"""
import json
import sys
import urllib.error
import urllib.request

from _amebo_env import read_env

METHODS = {"GET", "POST", "PATCH"}


def main():
    if len(sys.argv) < 3 or sys.argv[1] not in METHODS or not sys.argv[2].startswith("/api/") \
            or ".." in sys.argv[2]:
        sys.exit("usage: amebo-elm GET|POST|PATCH /api/<path> ['<json body>']")
    method, path = sys.argv[1], sys.argv[2]
    body = None
    if method != "GET":
        body = json.dumps(json.loads(sys.argv[3] if len(sys.argv) > 3 else "{}")).encode()
    env = read_env("ELM_BASE_URL", "ELM_API_KEY")
    req = urllib.request.Request(
        env["ELM_BASE_URL"].rstrip("/") + path, data=body, method=method,
        headers={"X-API-Key": env["ELM_API_KEY"], "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            print(r.read().decode())
    except urllib.error.HTTPError as e:
        sys.exit(f"HTTP {e.code}: {e.read().decode()[:500]}")


if __name__ == "__main__":
    main()
